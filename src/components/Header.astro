---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav class="header-nav">
		<div class="brand-group">
			<a href="/" class="brand-link">
				<img src="/Newlogo-2.png" alt="UWILL Logo" class="brand-logo" onerror="this.src='/Newlogo.png'" />
				<span class="brand-title">UWILL</span>
			</a>
		</div>

		<div class="nav-links">
			<HeaderLink href="/">Apps</HeaderLink>
			<HeaderLink href="/about">회사소개</HeaderLink>
		</div>

		<div class="header-actions">
			<a href="mailto:umaking@gmail.com" class="icon-link" title="이메일 문의: umaking@gmail.com">
				<span class="material-symbols-outlined">mail</span>
			</a>
			<a href="https://x.com/azovlive" target="_blank" rel="noopener noreferrer" class="icon-link" title="X (Twitter: @azovlive)">
				<span class="material-symbols-outlined">alternate_email</span>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(226, 232, 240, 0.85);
		box-shadow: 0 1px 8px rgba(15, 23, 42, 0.03);
		padding: 0 1.5rem;
		height: 64px;
		display: flex;
		align-items: center;
	}

	.header-nav {
		width: 100%;
		max-width: 1160px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		color: #0b1c30;
		text-decoration: none;
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
	}

	.brand-logo {
		width: 34px;
		height: 34px;
		object-fit: contain;
		border-radius: 9px;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		background: #f1f5f9;
		padding: 0.25rem;
		border-radius: 12px;
	}

	.nav-links :global(a) {
		padding: 0.4rem 1rem;
		color: #475569;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 600;
		border-radius: 9px;
		transition: all 0.15s ease;
		border: none;
	}

	.nav-links :global(a:hover) {
		color: #0b1c30;
		background: rgba(255, 255, 255, 0.6);
	}

	.nav-links :global(a.active) {
		background: #2563eb;
		color: #ffffff;
		box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.icon-link {
		width: 36px;
		height: 36px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		color: #64748b;
		background: #ffffff;
		border: 1px solid #e2e8f0;
		transition: all 0.15s ease;
	}

	.icon-link:hover {
		color: #2563eb;
		border-color: #cbd5e1;
		background: #eff6ff;
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.site-header {
			padding: 0 1rem;
			height: 58px;
		}
		.nav-links :global(a) {
			padding: 0.35rem 0.75rem;
			font-size: 0.82rem;
		}
	}
</style>
