---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-brand-row">
			<div class="footer-brand">
				<img src="/Newlogo-2.png" alt="UWILL Logo" class="footer-logo" onerror="this.src='/Newlogo.png'" />
				<div>
					<span class="footer-brand-name">UWILL</span>
					<span class="footer-copy">© {today.getFullYear()} UWILL. All rights reserved.</span>
				</div>
			</div>
			<div class="footer-tagline">
				<span>Native Software Lab · UWILL</span>
			</div>
		</div>

		<div class="footer-divider"></div>

		<div class="footer-bottom-row">
			<div class="footer-links">
				<a href="mailto:umaking@gmail.com" class="footer-link">
					<span class="material-symbols-outlined icon-sm">mail</span>
					<span>umaking@gmail.com</span>
				</a>
				<a href="https://x.com/azovlive" target="_blank" rel="noopener noreferrer" class="footer-link">
					<span class="material-symbols-outlined icon-sm">alternate_email</span>
					<span>@azovlive</span>
				</a>
				<a href="/about" class="footer-link">
					<span class="material-symbols-outlined icon-sm">info</span>
					<span>회사소개</span>
				</a>
			</div>
			<div class="footer-metrics">
				<span class="metric-pill">100% Native OS APIs</span>
				<span class="metric-pill">Zero Server Storage</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		width: 100%;
		background: #ffffff;
		border-top: 1px solid #e2e8f0;
		padding: 3rem 1.5rem 4rem;
		box-sizing: border-box;
		margin-top: auto;
	}

	.footer-container {
		max-width: 1160px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.footer-brand-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.footer-logo {
		width: 32px;
		height: 32px;
		border-radius: 8px;
		border: 1px solid #e2e8f0;
	}

	.footer-brand-name {
		font-weight: 800;
		color: #0b1c30;
		font-size: 1rem;
		margin-right: 0.5rem;
	}

	.footer-copy {
		font-size: 0.82rem;
		color: #64748b;
	}

	.footer-tagline {
		font-size: 0.8rem;
		color: #64748b;
		font-weight: 500;
	}

	.footer-divider {
		height: 1px;
		background: #f1f5f9;
		width: 100%;
	}

	.footer-bottom-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: #475569;
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.15s ease;
	}

	.footer-link:hover {
		color: #2563eb;
	}

	.icon-sm {
		font-size: 16px;
	}

	.footer-metrics {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.metric-pill {
		font-size: 0.72rem;
		font-family: 'JetBrains Mono', monospace;
		padding: 0.2rem 0.55rem;
		background: #f8fafc;
		border: 1px solid #e2e8f0;
		border-radius: 6px;
		color: #475569;
	}

	@media (max-width: 640px) {
		.site-footer {
			padding: 2rem 1rem 3rem;
		}
		.footer-brand-row,
		.footer-bottom-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
		}
		.footer-links {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
	}
</style>
