---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'apps'>['data'];

const {
	title,
	description,
	releaseDate,
	updatedDate,
	icon,
	downloadUrl,
	version,
	category,
	platforms,
	heroImage,
} = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${title} - UWILL`} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 920px;
				margin: 1.5rem auto 3rem;
				padding: 0 1.5rem 4rem;
				box-sizing: border-box;
			}

			.breadcrumb-bar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.84rem;
				color: #64748b;
				margin-bottom: 1.5rem;
			}

			.breadcrumb-link {
				color: #2563eb;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
			}

			.breadcrumb-link:hover {
				text-decoration: underline;
			}

			.app-header {
				display: flex;
				align-items: flex-start;
				gap: 1.75rem;
				padding: 2.25rem;
				background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
				border: 1px solid #dbeafe;
				border-radius: 24px;
				margin-bottom: 2.5rem;
				box-sizing: border-box;
				box-shadow: 0 4px 16px rgba(37, 99, 235, 0.04);
			}

			.app-icon {
				font-size: 3.5rem;
				line-height: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 88px;
				height: 88px;
				background: #ffffff;
				border-radius: 22px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
				border: 1px solid #e2e8f0;
				flex-shrink: 0;
			}

			.app-info {
				flex: 1;
				min-width: 0;
			}

			.app-title-row {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
				margin-bottom: 0.5rem;
			}

			.app-title {
				margin: 0;
				font-size: 1.85rem;
				font-weight: 800;
				color: #0b1c30;
				letter-spacing: -0.02em;
			}

			.version-badge {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.78rem;
				font-weight: 700;
				background: #eff6ff;
				color: #1d4ed8;
				padding: 0.2rem 0.6rem;
				border-radius: 9999px;
				border: 1px solid #dbeafe;
			}

			.category-badge {
				font-size: 0.78rem;
				background: #f1f5f9;
				color: #475569;
				padding: 0.2rem 0.6rem;
				border-radius: 8px;
				font-weight: 600;
			}

			.app-desc {
				margin: 0 0 1.25rem 0;
				color: #475569;
				font-size: 1.02rem;
				line-height: 1.6;
			}

			.meta-row {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				font-size: 0.85rem;
				color: #64748b;
				align-items: center;
			}

			.meta-item {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}

			.platforms-row {
				display: flex;
				gap: 0.35rem;
				margin-top: 0.75rem;
				flex-wrap: wrap;
			}

			.platform-tag {
				font-size: 0.74rem;
				background: #f8fafc;
				border: 1px solid #e2e8f0;
				padding: 0.15rem 0.55rem;
				border-radius: 6px;
				color: #475569;
				font-weight: 600;
			}

			.actions {
				display: flex;
				gap: 0.75rem;
				margin-top: 1.75rem;
				flex-wrap: wrap;
			}

			.btn-download {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.75rem 1.4rem;
				background: #2563eb;
				color: #ffffff !important;
				text-decoration: none;
				border-radius: 12px;
				font-weight: 700;
				font-size: 0.92rem;
				box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
				transition: all 0.2s;
			}

			.btn-download:hover {
				background: #1d4ed8;
				transform: translateY(-1px);
			}

			.btn-back {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.75rem 1.25rem;
				background: #ffffff;
				color: #334155 !important;
				text-decoration: none;
				border-radius: 12px;
				border: 1px solid #e2e8f0;
				font-weight: 600;
				font-size: 0.92rem;
				transition: all 0.2s;
			}

			.btn-back:hover {
				background: #f8fafc;
				border-color: #cbd5e1;
				transform: translateY(-1px);
			}

			.hero-image {
				width: 100%;
				margin-bottom: 2.5rem;
				border-radius: 18px;
				overflow: hidden;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
				border: 1px solid #e2e8f0;
			}

			.hero-image img {
				width: 100%;
				max-height: 440px;
				object-fit: cover;
			}

			.content-body {
				line-height: 1.75;
				color: #334155;
				font-size: 1.02rem;
			}

			.content-body :global(h2) {
				margin-top: 2rem;
				margin-bottom: 0.75rem;
				font-size: 1.45rem;
				border-bottom: 1px solid #e2e8f0;
				padding-bottom: 0.5rem;
			}

			.content-body :global(ul) {
				padding-left: 1.25rem;
				margin-bottom: 1.5rem;
			}

			.content-body :global(li) {
				margin-bottom: 0.4rem;
			}

			@media (max-width: 640px) {
				main {
					padding: 0 1rem 3rem;
					margin: 1rem auto;
				}
				.app-header {
					flex-direction: column;
					align-items: flex-start;
					padding: 1.5rem 1.25rem;
					border-radius: 20px;
					gap: 1.25rem;
				}
				.app-icon {
					width: 72px;
					height: 72px;
					font-size: 2.75rem;
				}
				.app-title {
					font-size: 1.45rem;
				}
				.actions {
					flex-direction: column;
					width: 100%;
				}
				.btn-download,
				.btn-back {
					width: 100%;
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="breadcrumb-bar">
				<a href="/" class="breadcrumb-link">
					<span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
					<span>홈으로</span>
				</a>
				<span>/</span>
				<span>앱 상세</span>
				<span>/</span>
				<span style="color: #0b1c30; font-weight: 600;">{title}</span>
			</div>

			<div class="app-header">
				<div class="app-icon">{icon || '📱'}</div>
				<div class="app-info">
					<div class="app-title-row">
						<h1 class="app-title">{title}</h1>
						{version && <span class="version-badge">v{version}</span>}
						{category && <span class="category-badge">{category}</span>}
					</div>

					<p class="app-desc">{description}</p>

					<div class="meta-row">
						<div class="meta-item">
							<span class="material-symbols-outlined" style="font-size: 16px;">calendar_today</span>
							<span>릴리즈: <FormattedDate date={releaseDate} /></span>
						</div>
						{updatedDate && (
							<div class="meta-item">
								<span class="material-symbols-outlined" style="font-size: 16px;">update</span>
								<span>업데이트: <FormattedDate date={updatedDate} /></span>
							</div>
						)}
					</div>

					{platforms && platforms.length > 0 && (
						<div class="platforms-row">
							{platforms.map((p) => (
								<span class="platform-tag">{p}</span>
							))}
						</div>
					)}

					<div class="actions">
						{downloadUrl && (
							<a
								href={downloadUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="btn-download"
							>
								<span class="material-symbols-outlined" style="font-size: 18px;">download</span>
								<span>App Store 다운로드</span>
							</a>
						)}
						<a href="/" class="btn-back">
							<span class="material-symbols-outlined" style="font-size: 18px;">grid_view</span>
							<span>다른 앱 둘러보기</span>
						</a>
					</div>
				</div>
			</div>

			{heroImage && (
				<div class="hero-image">
					<Image width={860} height={400} src={heroImage} alt={title} />
				</div>
			)}

			<article class="content-body">
				<slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
