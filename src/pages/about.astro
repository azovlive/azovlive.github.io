---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`About - ${SITE_TITLE}`}
			description="UWILL의 10년 여정과 네이티브 소프트웨어 개발 철학을 소개합니다."
		/>
		<style>
			main {
				width: 100%;
				max-width: 1160px;
				margin: 0 auto;
				padding: 2.5rem 1.5rem 5rem;
				box-sizing: border-box;
			}

			/* Hero Section - Identical to Apps page */
			.hero {
				position: relative;
				text-align: center;
				padding: 3.5rem 1.5rem 3rem;
				background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
				border-radius: 28px;
				border: 1px solid #dbeafe;
				box-shadow: 0 4px 20px -2px rgba(37, 99, 235, 0.05);
				margin-bottom: 3rem;
				overflow: hidden;
			}
			.hero-glow {
				position: absolute;
				top: -120px;
				left: 50%;
				transform: translateX(-50%);
				width: 700px;
				height: 350px;
				background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, rgba(99, 102, 241, 0.05) 60%, transparent 80%);
				filter: blur(50px);
				pointer-events: none;
			}
			.hero-logo-badge {
				width: 72px;
				height: 72px;
				margin: 0 auto 1.5rem;
				border-radius: 18px;
				background: #ffffff;
				padding: 6px;
				border: 1px solid #dbeafe;
				box-shadow: 0 8px 24px -4px rgba(37, 99, 235, 0.12);
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.hero-logo-img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				border-radius: 13px;
			}
			.hero h1 {
				font-size: clamp(1.8rem, 4.5vw, 2.85rem);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.25;
				margin: 0 0 1rem;
				color: #0b1c30;
			}
			.gradient-text {
				background: linear-gradient(135deg, #004ac6 0%, #4f46e5 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.hero-desc {
				font-size: clamp(0.95rem, 2vw, 1.12rem);
				color: #475569;
				max-width: 640px;
				margin: 0 auto 2rem;
				line-height: 1.65;
				word-break: keep-all;
			}
			.hero-actions {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				flex-wrap: wrap;
				margin-bottom: 2.5rem;
			}
			.btn-cta-primary {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.75rem 1.4rem;
				background: #2563eb;
				color: #ffffff !important;
				font-size: 0.92rem;
				font-weight: 600;
				border-radius: 12px;
				box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);
				transition: all 0.2s;
			}
			.btn-cta-primary:hover {
				background: #1d4ed8;
				transform: translateY(-1px);
			}
			.btn-cta-secondary {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.75rem 1.4rem;
				background: #ffffff;
				color: #0b1c30 !important;
				font-size: 0.92rem;
				font-weight: 600;
				border-radius: 12px;
				border: 1px solid #e2e8f0;
				box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
				transition: all 0.2s;
			}
			.btn-cta-secondary:hover {
				background: #eff6ff;
				border-color: #cbd5e1;
				transform: translateY(-1px);
			}

			/* Key Metrics Grid - 3 Columns (Identical to Apps page) */
			.metrics-bar {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
				background: rgba(255, 255, 255, 0.85);
				backdrop-filter: blur(12px);
				border: 1px solid #e2e8f0;
				border-radius: 20px;
				padding: 1.25rem 1.5rem;
				max-width: 780px;
				margin: 0 auto;
			}
			.metric-item {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
			}
			.metric-value {
				font-size: 1.75rem;
				font-weight: 800;
				line-height: 1.2;
				letter-spacing: -0.02em;
			}
			.metric-value.c-blue { color: #004ac6; }
			.metric-value.c-indigo { color: #4f46e5; }
			.metric-value.c-emerald { color: #10b981; }
			.metric-label {
				font-size: 0.76rem;
				color: #64748b;
				margin-top: 0.2rem;
				font-weight: 500;
			}

			/* Principles Section - 3 Principles */
			.principles-section {
				margin-bottom: 4rem;
			}
			.section-heading-wrap {
				margin-bottom: 2rem;
			}
			.section-eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.75rem;
				font-weight: 700;
				color: #004ac6;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				margin-bottom: 0.35rem;
			}
			.section-main-title {
				font-size: 1.85rem;
				font-weight: 800;
				color: #0b1c30;
				letter-spacing: -0.02em;
				margin-bottom: 0.5rem;
			}
			.section-lead-text {
				font-size: 0.95rem;
				color: #64748b;
				margin: 0;
			}

			.principles-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}
			.principle-card {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 20px;
				padding: 1.75rem;
				box-shadow: 0 2px 6px rgba(15, 23, 42, 0.02);
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.principle-card:hover {
				border-color: #cbd5e1;
				box-shadow: 0 10px 20px rgba(15, 23, 42, 0.04);
			}
			.principle-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1.25rem;
			}
			.principle-code {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				font-weight: 700;
				padding: 0.25rem 0.6rem;
				border-radius: 8px;
			}
			.principle-code.blue { background: #eff6ff; color: #1d4ed8; }
			.principle-code.emerald { background: #ecfdf5; color: #047857; }
			.principle-code.indigo { background: #e0e7ff; color: #4338ca; }

			.principle-icon {
				width: 40px;
				height: 40px;
				border-radius: 12px;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 20px;
			}
			.principle-icon.blue { background: #dbeafe; color: #1d4ed8; }
			.principle-icon.emerald { background: #d1fae5; color: #047857; }
			.principle-icon.indigo { background: #e0e7ff; color: #4338ca; }

			.principle-title {
				font-size: 1.2rem;
				font-weight: 700;
				color: #0b1c30;
				margin-bottom: 0.5rem;
			}
			.principle-desc {
				font-size: 0.9rem;
				color: #475569;
				line-height: 1.65;
				margin-bottom: 1.5rem;
			}
			.principle-tag {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.74rem;
				font-weight: 600;
				font-family: 'JetBrains Mono', monospace;
			}
			.principle-tag.blue { color: #1d4ed8; }
			.principle-tag.emerald { color: #047857; }
			.principle-tag.indigo { color: #4338ca; }

			/* Timeline Section */
			.timeline-section {
				background: #eff4ff;
				border-radius: 28px;
				padding: 3rem 2.5rem;
				margin-bottom: 4rem;
				border: 1px solid #dbeafe;
			}
			.timeline-header {
				text-align: center;
				max-width: 600px;
				margin: 0 auto 3rem;
			}
			.timeline-tree {
				position: relative;
				max-width: 760px;
				margin: 0 auto;
				padding-left: 2rem;
			}
			.timeline-tree::before {
				content: '';
				position: absolute;
				left: 6px;
				top: 8px;
				bottom: 8px;
				width: 2px;
				background: #cbd5e1;
			}
			.timeline-node {
				position: relative;
				margin-bottom: 2.5rem;
			}
			.timeline-node:last-child {
				margin-bottom: 0;
			}
			.node-dot {
				position: absolute;
				left: -2rem;
				top: 4px;
				width: 14px;
				height: 14px;
				border-radius: 50%;
				background: #ffffff;
				border: 3px solid #004ac6;
				box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
			}
			.node-dot.current {
				background: #2563eb;
				border-color: #ffffff;
				box-shadow: 0 0 0 4px #2563eb;
			}
			.node-content-card {
				background: #ffffff;
				border-radius: 18px;
				padding: 1.5rem;
				border: 1px solid #e2e8f0;
				box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
			}
			.node-year-badge {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 0.5rem;
			}
			.node-year {
				font-size: 1.25rem;
				font-weight: 800;
				color: #004ac6;
				font-family: 'JetBrains Mono', monospace;
			}
			.node-stage {
				font-size: 0.72rem;
				background: #eff6ff;
				color: #1d4ed8;
				padding: 0.15rem 0.5rem;
				border-radius: 9999px;
				font-weight: 600;
			}
			.node-title {
				font-size: 1.05rem;
				font-weight: 700;
				color: #0b1c30;
				margin-bottom: 0.35rem;
			}
			.node-text {
				font-size: 0.88rem;
				color: #475569;
				line-height: 1.6;
				margin: 0 0 0.75rem 0;
			}
			.node-chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
			}
			.node-chip {
				font-size: 0.72rem;
				background: #f1f5f9;
				color: #475569;
				padding: 0.15rem 0.5rem;
				border-radius: 6px;
				font-weight: 500;
			}

			/* What We Build */
			.apps-showcase-section {
				margin-bottom: 4rem;
			}
			.apps-showcase-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.25rem;
			}
			.showcase-item {
				background: #ffffff;
				border: 1px solid #e2e8f0;
				border-radius: 18px;
				padding: 1.5rem;
				transition: all 0.2s ease;
				text-decoration: none;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.showcase-item:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 24px rgba(15, 23, 42, 0.05);
				border-color: #cbd5e1;
			}
			.showcase-icon {
				font-size: 2.2rem;
				margin-bottom: 0.75rem;
			}
			.showcase-name {
				font-size: 1.15rem;
				font-weight: 700;
				color: #0b1c30;
				margin-bottom: 0.35rem;
			}
			.showcase-desc {
				font-size: 0.86rem;
				color: #64748b;
				line-height: 1.55;
				margin: 0 0 1rem 0;
				flex: 1;
			}
			.showcase-link-text {
				font-size: 0.82rem;
				font-weight: 600;
				color: #004ac6;
				display: inline-flex;
				align-items: center;
				gap: 0.25rem;
			}

			/* Bottom Section (Engineer's Note & Official Channels) - Identical layout container */
			.bottom-preview-section {
				background: #eff4ff;
				border-radius: 28px;
				padding: 2.5rem;
				display: grid;
				grid-template-columns: 1.2fr 0.8fr;
				gap: 2rem;
				align-items: stretch;
				border: 1px solid #dbeafe;
			}
			.engineer-note-box {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
			}
			.engineer-quote-title {
				font-size: 1.55rem;
				font-weight: 800;
				color: #0b1c30;
				line-height: 1.35;
				margin-bottom: 1.25rem;
			}
			.engineer-body {
				font-size: 0.92rem;
				color: #475569;
				line-height: 1.65;
			}
			.engineer-body p {
				margin-bottom: 0.85rem;
			}
			.engineer-profile-bar {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				margin-top: 1.5rem;
				padding-top: 1.25rem;
				border-top: 1px solid #dbeafe;
			}
			.engineer-avatar {
				width: 44px;
				height: 44px;
				border-radius: 50%;
				background: #ffffff;
				color: #004ac6;
				font-weight: 800;
				font-size: 1rem;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #cbd5e1;
			}
			.engineer-name {
				font-size: 0.95rem;
				font-weight: 700;
				color: #0b1c30;
			}
			.engineer-role {
				font-size: 0.78rem;
				color: #64748b;
			}

			/* Channels Box */
			.channels-card {
				background: #ffffff;
				border-radius: 20px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				border: 1px solid #dbeafe;
				box-shadow: 0 4px 12px rgba(37, 99, 235, 0.04);
			}
			.channels-title {
				font-size: 1.15rem;
				font-weight: 800;
				color: #0b1c30;
				margin-bottom: 0.25rem;
			}
			.channels-sub {
				font-size: 0.82rem;
				color: #64748b;
				margin-bottom: 1.25rem;
				line-height: 1.5;
			}
			.channel-list {
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
				margin-bottom: 1.25rem;
			}
			.channel-item {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 0.85rem;
				background: #f8fafc;
				border-radius: 12px;
				border: 1px solid #e2e8f0;
				color: inherit;
				text-decoration: none;
				transition: all 0.15s;
			}
			.channel-item:hover {
				border-color: #2563eb;
				background: #eff6ff;
				transform: translateY(-1px);
			}
			.channel-left {
				display: flex;
				align-items: center;
				gap: 0.65rem;
			}
			.channel-icon-wrap {
				width: 32px;
				height: 32px;
				border-radius: 8px;
				background: #ffffff;
				color: #004ac6;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid #e2e8f0;
			}
			.channel-label {
				font-size: 0.82rem;
				font-weight: 700;
				color: #0b1c30;
				display: block;
			}
			.channel-detail {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				color: #64748b;
			}
			.active-tag {
				font-size: 0.68rem;
				font-weight: 700;
				background: #d1fae5;
				color: #065f46;
				padding: 0.15rem 0.45rem;
				border-radius: 6px;
			}
			.btn-explore-apps {
				width: 100%;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				padding: 0.75rem;
				background: #2563eb;
				color: #ffffff !important;
				font-size: 0.88rem;
				font-weight: 700;
				border-radius: 12px;
				box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
				transition: background 0.15s;
			}
			.btn-explore-apps:hover {
				background: #1d4ed8;
			}

			/* Responsive */
			@media (max-width: 900px) {
				.principles-grid {
					grid-template-columns: 1fr;
				}
				.bottom-preview-section {
					grid-template-columns: 1fr;
				}
			}

			@media (max-width: 640px) {
				main {
					padding: 1.25rem 1rem 4rem;
				}
				.hero {
					padding: 2.25rem 1rem;
					border-radius: 20px;
					margin-bottom: 2rem;
				}
				.hero h1 {
					font-size: 1.55rem;
				}
				.hero-logo-badge {
					width: 60px;
					height: 60px;
					margin-bottom: 1rem;
				}
				.metrics-bar {
					grid-template-columns: 1fr;
					gap: 0.75rem;
					padding: 1rem;
				}
				.timeline-section {
					padding: 1.75rem 1.25rem;
					border-radius: 20px;
				}
				.bottom-preview-section {
					padding: 1.5rem 1rem;
					border-radius: 20px;
				}
				.engineer-quote-title {
					font-size: 1.35rem;
				}
				.apps-showcase-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section - Exactly identical to Apps page -->
			<section class="hero">
				<div class="hero-glow"></div>
				<div class="hero-logo-badge">
					<img src="/Newlogo-2.webp" alt="UWILL Logo" class="hero-logo-img" width="72" height="72" />
				</div>
				<h1>
					일상과 업무의 몰입을 돕는<br />
					<span class="gradient-text">단단하고 유용한 도구</span>를 만듭니다
				</h1>
				<p class="hero-desc">
					2015년 첫 앱 출시 이후 10년 넘게 본질에 집중한 네이티브 유틸리티 소프트웨어를 지속적으로 빌드해오고 있습니다.
					손끝에서 즉각 반응하는 기술적 완성도와 네이티브 소프트웨어 본연의 가치를 지향합니다.
				</p>
				<div class="hero-actions">
					<a href="/" class="btn-cta-primary">
						<span class="material-symbols-outlined">arrow_back</span>
						<span>출시된 앱 전체 보기</span>
					</a>
					<a href="mailto:umaking@gmail.com" class="btn-cta-secondary">
						<span class="material-symbols-outlined">mail</span>
						<span>Mail to Us</span>
					</a>
				</div>

				<!-- Key Metrics Bar - Exactly identical to Apps page (3 Columns) -->
				<div class="metrics-bar">
					<div class="metric-item">
						<span class="metric-value c-blue">10+년</span>
						<span class="metric-label">2015-2026 지속적 빌드</span>
					</div>
					<div class="metric-item">
						<span class="metric-value c-indigo">7개</span>
						<span class="metric-label">자체 개발 라인업</span>
					</div>
					<div class="metric-item">
						<span class="metric-value c-emerald">100%</span>
						<span class="metric-label">네이티브 최적화</span>
					</div>
				</div>
			</section>

			<!-- 3 Core Principles -->
			<section class="principles-section">
				<div class="section-heading-wrap">
					<div class="section-eyebrow">
						<span class="material-symbols-outlined" style="font-size: 16px;">verified</span>
						<span>Core Principles</span>
					</div>
					<h2 class="section-main-title">3대 핵심 개발 원칙</h2>
					<p class="section-lead-text">
						타협하지 않는 기술 표준과 사용자 존중을 바탕으로 소프트웨어를 설계합니다.
					</p>
				</div>

				<div class="principles-grid">
					<!-- 01 Native Performance -->
					<div class="principle-card">
						<div>
							<div class="principle-top">
								<span class="principle-code blue">01 / ARCHITECTURE</span>
								<div class="principle-icon blue">
									<span class="material-symbols-outlined">speed</span>
								</div>
							</div>
							<h3 class="principle-title">네이티브 퍼포먼스</h3>
							<p class="principle-desc">
