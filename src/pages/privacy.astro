		<script>
			// Language switching logic with URL hash support
			function setupLangSwitcher() {
				const btnKo = document.getElementById('btn-ko');
				const btnEn = document.getElementById('btn-en');
				const contentKo = document.getElementById('content-ko');
				const contentEn = document.getElementById('content-en');

				function setLang(lang: string) {
					if (lang === 'en') {
						btnEn?.classList.add('active');
						btnEn?.setAttribute('aria-selected', 'true');
						btnKo?.classList.remove('active');
						btnKo?.setAttribute('aria-selected', 'false');
						contentEn?.classList.add('active');
						contentKo?.classList.remove('active');
						history.replaceState(null, '', '#en');
					} else {
						btnKo?.classList.add('active');
						btnKo?.setAttribute('aria-selected', 'true');
						btnEn?.classList.remove('active');
						btnEn?.setAttribute('aria-selected', 'false');
						contentKo?.classList.add('active');
						contentEn?.classList.remove('active');
						history.replaceState(null, '', '#ko');
					}
				}

				btnKo?.addEventListener('click', () => setLang('ko'));
				btnEn?.addEventListener('click', () => setLang('en'));

				// Check URL hash or query param or browser language
				const hash = window.location.hash.toLowerCase();
				const urlParams = new URLSearchParams(window.location.search);
				const langParam = urlParams.get('lang');

				if (hash === '#en' || langParam === 'en') {
					setLang('en');
				} else if (hash === '#ko' || langParam === 'ko') {
					setLang('ko');
				} else {
					// Default to English if non-Korean browser, otherwise Korean
					const userLang = navigator.language || '';
					if (userLang.toLowerCase().startsWith('ko')) {
						setLang('ko');
					} else {
						setLang('en');
					}
				}
			}

			// Initialize
			setupLangSwitcher();
		</script>
